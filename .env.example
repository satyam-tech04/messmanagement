    # ---------------------------------------------------------------------------
# Copy to `.env` and fill in. NEVER commit `.env`.
#
# This project keeps credentials in `.env`, NOT `.env.local`, so that migrations
# and app code always resolve the same file. Do not create a `.env.local`:
# Next.js prefers it over `.env`, which would silently point the app at one
# database while your migrations target another.
#
# Rule (architecture doc §5.3): anything prefixed NEXT_PUBLIC_ is shipped to the
# browser in plaintext. Only the two Supabase public values below may carry it.
# ---------------------------------------------------------------------------

# --- Supabase: public (safe for the browser, protected by RLS) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase: server-only. Bypasses RLS entirely. Never NEXT_PUBLIC_. ---
SUPABASE_SERVICE_ROLE_KEY=

# --- Supabase CLI (migrations) ---
# Project ref is the subdomain of your Supabase URL.
SUPABASE_PROJECT_REF=
# Database password, used by `supabase db push`.
SUPABASE_DB_PASSWORD=

# --- QR signing (architecture doc §6.2) ---
# Fallback HMAC secret used when a tenant has no per-tenant secret provisioned.
# Generate with: openssl rand -base64 48
QR_SIGNING_SECRET=

# --- Cron endpoint protection (§9) ---
# Sent as the `x-cron-secret` header by the scheduler; /api/cron/* rejects
# anything else. Generate with: openssl rand -base64 32
CRON_SECRET=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Phase 2 (money layer) — not required for the Phase 0/1 MVP ---
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# Admin-only website. "true" refuses student and counter-staff sign-in on the web
# and points them to the MealAdda app. Leave "false" until every mess on this
# deployment has the app installed. (docs/RUNBOOK.md)
WEB_SIGNIN_APP_ONLY=false

# The oldest mobile build the API still serves (D-33). Anything older shows a
# blocking "update to carry on" screen. 0 blocks nobody, which is the default;
# raise it on the day a breaking change ships. Must be a build number from
# mobile/pubspec.yaml (the `+n` part), never a version name.
MIN_APP_BUILD=0

# Firebase service account for push notifications (D-34), as raw JSON or base64
# of the JSON file. Absent — which is the default — push is simply off: the app
# works normally and the admin console says notifications are not configured.
# See docs/PUSH-SETUP.md. This is a SECRET: it can notify every student as you.
FIREBASE_SERVICE_ACCOUNT_JSON=
