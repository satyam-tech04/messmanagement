# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# supabase cli local state
supabase/.temp
supabase/.branches

# playwright
/test-results
/playwright-report
/blob-report
/playwright/.cache

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local scratch
.scratch/

# Per-machine Claude Code settings (permission approvals). The shared
# .claude/settings.json is committed; this one is personal.
.claude/settings.local.json
